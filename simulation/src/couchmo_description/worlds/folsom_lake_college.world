<?xml version="1.0"?>
<!--
  folsom_lake_college.world  —  Gazebo Classic 11
  Approximate layout of Folsom Lake College, Folsom CA
  Scale: 1:1 meters, world spans ~180m W × 140m N
  Origin (0,0) = center of main quad

  Simplified building footprints based on general campus structure:
    - Main quad / central plaza
    - Library (NW)
    - Science & Math (NE)
    - Student Services / Admin (SW)
    - Arts & Humanities (SE)
    - Gymnasium / PE (far north)
    - Main campus road loop
    - East & West parking lots
    - Trees, benches, signs as navigation obstacles

  Pathways are 5–6m wide to accommodate the couch (1.83m) with clearance.
-->
<sdf version="1.6">
  <world name="folsom_lake_college">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ══════════════════════════════════════════════════════
         CAMPUS PERIMETER ROAD  (concrete, no wall — open campus)
         Represented as raised curb strips 0.15m tall
    ══════════════════════════════════════════════════════════ -->

    <!-- South perimeter road / main entrance corridor -->
    <!-- Entry road: 8m wide, runs N-S at x=0 from y=-70 to quad -->
    <!-- Curb east side of entry road -->
    <model name="curb_entry_east">
      <static>true</static>
      <pose>5 -55 0.075 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 30 0.15</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 30 0.15</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Curb west side of entry road -->
    <model name="curb_entry_west">
      <static>true</static>
      <pose>-5 -55 0.075 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 30 0.15</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 30 0.15</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Campus loop road — north section -->
    <model name="road_north_curb_south">
      <static>true</static>
      <pose>0 45 0.075 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>120 0.3 0.15</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>120 0.3 0.15</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East campus loop road -->
    <model name="road_east_curb">
      <static>true</static>
      <pose>60 5 0.075 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 80 0.15</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 80 0.15</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West campus loop road -->
    <model name="road_west_curb">
      <static>true</static>
      <pose>-60 5 0.075 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 80 0.15</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 80 0.15</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════
         BUILDINGS
         All 3.5m tall, flat-roofed, concrete/stucco appearance
    ══════════════════════════════════════════════════════════ -->

    <!-- LIBRARY  —  NW of quad, ~30m × 18m -->
    <model name="library">
      <static>true</static>
      <pose>-32 18 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>30 18 3.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>30 18 3.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.72 1</ambient><diffuse>0.82 0.78 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Library wing (reading room extension) -->
    <model name="library_wing">
      <static>true</static>
      <pose>-42 10 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 10 3.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10 10 3.5</size></box></geometry>
          <material><ambient>0.80 0.76 0.70 1</ambient><diffuse>0.80 0.76 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SCIENCE & MATH  —  NE, ~35m × 20m -->
    <model name="science_math">
      <static>true</static>
      <pose>30 22 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>35 20 3.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>35 20 3.5</size></box></geometry>
          <material><ambient>0.72 0.75 0.80 1</ambient><diffuse>0.72 0.75 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Science lab annex -->
    <model name="science_annex">
      <static>true</static>
      <pose>50 12 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>12 16 3.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>12 16 3.5</size></box></geometry>
          <material><ambient>0.70 0.73 0.78 1</ambient><diffuse>0.70 0.73 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- STUDENT SERVICES / ADMIN  —  SW, ~25m × 14m -->
    <model name="student_services">
      <static>true</static>
      <pose>-28 -18 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>25 14 3.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>25 14 3.5</size></box></geometry>
          <material><ambient>0.85 0.80 0.74 1</ambient><diffuse>0.85 0.80 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ARTS & HUMANITIES  —  SE, ~28m × 16m -->
    <model name="arts_humanities">
      <static>true</static>
      <pose>32 -20 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>28 16 3.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>28 16 3.5</size></box></geometry>
          <material><ambient>0.78 0.72 0.82 1</ambient><diffuse>0.78 0.72 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- GYMNASIUM / PE  —  Far north, ~40m × 28m, taller -->
    <model name="gymnasium">
      <static>true</static>
      <pose>0 60 4.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>40 28 8.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>40 28 8.0</size></box></geometry>
          <material><ambient>0.60 0.62 0.65 1</ambient><diffuse>0.60 0.62 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- CAFETERIA / STUDENT CENTER  —  North of quad -->
    <model name="cafeteria">
      <static>true</static>
      <pose>-8 35 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>22 12 3.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>22 12 3.5</size></box></geometry>
          <material><ambient>0.88 0.83 0.70 1</ambient><diffuse>0.88 0.83 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- TECHNOLOGY / CTE  —  East mid -->
    <model name="technology_cte">
      <static>true</static>
      <pose>50 -5 1.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>18 22 3.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>18 22 3.5</size></box></geometry>
          <material><ambient>0.74 0.76 0.80 1</ambient><diffuse>0.74 0.76 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════
         MAIN QUAD  —  open paved plaza ~20m × 18m at (0,0)
         Bounded by low planters (0.5m tall × 0.4m wide)
    ══════════════════════════════════════════════════════════ -->

    <!-- North planter -->
    <model name="quad_planter_north">
      <static>true</static>
      <pose>0 10 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20 0.4 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>20 0.4 0.5</size></box></geometry>
          <material><ambient>0.45 0.55 0.35 1</ambient><diffuse>0.45 0.55 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South planter -->
    <model name="quad_planter_south">
      <static>true</static>
      <pose>0 -10 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>20 0.4 0.5</size></box></geometry></collision>
        <visual name="vis">
