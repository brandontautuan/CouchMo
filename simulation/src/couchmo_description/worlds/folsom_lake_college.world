    <model name="student_1">
      <static>false</static>
      <pose>3 -5 0.9 0 0 0</pose>
      <link name="link">
        <inertial><mass>65</mass><inertia><ixx>8</ixx><iyy>8</iyy><izz>1.5</izz></inertia></inertial>
        <collision name="col"><geometry><cylinder><radius>0.22</radius><length>1.8</length></cylinder></geometry></collision>
